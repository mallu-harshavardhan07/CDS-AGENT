# =============================================================================
# SAP S/4HANA Connection Configuration (01_extract.py)
# =============================================================================
SAP_BASE_URL=https://YAWSS4HSBX.sapyash.com:44301
SAP_CLIENT=100
SAP_USERNAME=AIENAPARTHIP
SAP_PASSWORD=Training@2026
SAP_VERIFY_SSL=false
SAP_REQUEST_TIMEOUT_SECONDS=30
SAP_MAX_VIEWS=50

# Legacy fallback compatibility parameters
SAP_HOST=YAWSS4HSBX.sapyash.com
SAP_PORT=44301
SAP_USER=AIENAPARTHIP
SAP_USE_SSL=true
SAP_USE_MOCK=false

# =============================================================================
# Vector Indexing & Embeddings (02_build_index.py & 03_server.py)
# =============================================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_DB_PATH=./cds_vector_db
CHROMA_COLLECTION_NAME=cds_views

# =============================================================================
# FastAPI Core & LLM Configuration (03_server.py)
# =============================================================================
PORT=8000
HOST=0.0.0.0

# OpenAI API Key (or leave blank to use the built-in deterministic rules engine)
OPENAI_API_KEY=your_openai_api_key_here

# Custom Base URL for Local LLMs (Ollama, vLLM, LM Studio, etc.)
# Examples:
#   Ollama: http://localhost:11434/v1
#   vLLM:   http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# =============================================================================
# Architectural Decision Engine Thresholds (03_server.py)
# =============================================================================
# Similarity score threshold to recommend REUSE (e.g. 0.25 / 25%, 0.30, or 0.50)
REUSE_THRESHOLD=0.25
# Similarity score threshold to recommend EXTEND (below REUSE_THRESHOLD)
EXTEND_THRESHOLD=0.15
