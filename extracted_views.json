    "ddl_code": "@AbapCatalog.sqlViewName: 'IMATERIALSTOCK'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Material Stock'\n@Analytics.dataCategory: #FACT\n@VDM.viewType: #BASIC\n\ndefine view I_MaterialStock\n  as select from mard as Stock\n  association [0..1] to I_Product as _Product\n    on $projection.Material = _Product.Product\n{\n  key Stock.matnr as Material,\n  key Stock.werks as Plant,\n  key Stock.lgort as StorageLocation,\n      @DefaultAggregation: #SUM\n      Stock.labst as UnrestrictedStockQuantity,\n      @DefaultAggregation: #SUM\n      Stock.umlme as StockInTransferQuantity,\n      @DefaultAggregation: #SUM\n      Stock.insme as QualityInspectionStockQuantity,\n      _Product\n}"
  },
