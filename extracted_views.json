    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'IPURCHASEORDER01'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Purchase Order'\n@VDM.viewType: #COMPOSITE\n\ndefine view I_PurchaseOrderAPI01\n  as select from ekko as PoHeader\n  association [0..*] to I_PurchaseOrderItemAPI01 as _PurchaseOrderItem\n    on $projection.PurchaseOrder = _PurchaseOrderItem.PurchaseOrder\n  association [0..1] to I_Supplier              as _Supplier\n    on $projection.Supplier = _Supplier.Supplier\n{\n  key PoHeader.ebeln as PurchaseOrder,\n      PoHeader.bsart as PurchaseOrderType,\n      PoHeader.lifnr as Supplier,\n      PoHeader.bukrs as CompanyCode,\n      PoHeader.ekorg as PurchasingOrganization,\n      PoHeader.ekgrp as PurchasingGroup,\n      PoHeader.aedat as PurchaseOrderDate,\n      PoHeader.waers as DocumentCurrency,\n      PoHeader.bedat as PurchasingDocumentDate,\n      _PurchaseOrderItem,\n      _Supplier\n}"
  },
  {
    "view_name": "I_JournalEntry",
    "ddl_source_name": "I_JOURNALENTRY",
    "description": "General Ledger Journal Entry Header",
    "annotations": [
      "@AccessControl.authorizationCheck: #CHECK",
      "@Analytics.dataCategory: #DIMENSION",
      "@EndUserText.label: 'Journal Entry Header'",
      "@ObjectModel.representativeKey: 'AccountingDocument'",
      "@VDM.viewType: #BASIC"
    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'IFIGLHEADER'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Journal Entry Header'\n@VDM.viewType: #BASIC\n\ndefine view I_JournalEntry\n  as select from bkpf as Header\n  association [0..*] to I_JournalEntryItem as _Item\n    on  $projection.CompanyCode        = _Item.CompanyCode\n    and $projection.AccountingDocument = _Item.AccountingDocument\n    and $projection.FiscalYear         = _Item.FiscalYear\n{\n  key Header.bukrs as CompanyCode,\n  key Header.belnr as AccountingDocument,\n  key Header.gjahr as FiscalYear,\n      Header.blart as AccountingDocumentType,\n      Header.bldat as DocumentDate,\n      Header.budat as PostingDate,\n      Header.monat as FiscalPeriod,\n      Header.waers as CompanyCodeCurrency,\n      Header.xblnr as ReferenceDocumentNumber,\n      Header.bktxt as DocumentHeaderText,\n      _Item\n}"
  },
  {
