    "ddl_code": "@AbapCatalog.sqlViewName: 'ICUSTOMER'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Customer'\n@Search.searchable: true\n@VDM.viewType: #BASIC\n\ndefine view I_Customer\n  as select from kna1 as Customer\n{\n  key Customer.kunnr as Customer,\n      @Search.defaultSearchElement: true\n      Customer.name1 as CustomerName,\n      Customer.name2 as AdditionalCustomerName,\n      Customer.ort01 as CityName,\n      Customer.pstlz as PostalCode,\n      Customer.land1 as Country,\n      Customer.regio as Region,\n      Customer.stras as StreetName,\n      Customer.ktokd as CustomerAccountGroup,\n      Customer.stceg as VATRegistration,\n      Customer.erdat as CreatedByUserDate\n}"
