  {
    "view_name": "I_SalesOrder",
    "ddl_source_name": "I_SALESORDER",
    "description": "Sales Order Header View",
    "annotations": [
      "@AccessControl.authorizationCheck: #CHECK",
      "@Analytics.dataCategory: #DIMENSION",
      "@EndUserText.label: 'Sales Order'",
      "@ObjectModel.representativeKey: 'SalesOrder'",
      "@ObjectModel.semanticKey: ['SalesOrder']",
      "@VDM.viewType: #BASIC"
    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'ISALESORDER'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Sales Order'\n@VDM.viewType: #BASIC\n@ObjectModel.representativeKey: 'SalesOrder'\n@ObjectModel.semanticKey: ['SalesOrder']\n\ndefine view I_SalesOrder\n  as select from vbak as SalesOrder\n  association [0..*] to I_SalesOrderItem as _Item\n    on $projection.SalesOrder = _Item.SalesOrder\n  association [0..1] to I_Customer       as _Customer\n    on $projection.SoldToParty = _Customer.Customer\n{\n  key SalesOrder.vbeln as SalesOrder,\n      SalesOrder.auart as SalesOrderType,\n      SalesOrder.vkorg as SalesOrganization,\n      SalesOrder.vtweg as DistributionChannel,\n      SalesOrder.spart as OrganizationDivision,\n      SalesOrder.kunnr as SoldToParty,\n      SalesOrder.audat as DocumentDate,\n      SalesOrder.erdat as CreationDate,\n      SalesOrder.netwr as TotalNetAmount,\n      SalesOrder.waerk as TransactionCurrency,\n      SalesOrder.faksk as BillingBlockStatus,\n      SalesOrder.lifsk as DeliveryBlockStatus,\n      _Item,\n      _Customer\n}"
  },
  {
    "view_name": "I_SalesOrderItem",
    "ddl_source_name": "I_SALESORDERITEM",
    "description": "Sales Order Item View",
    "annotations": [
      "@AccessControl.authorizationCheck: #CHECK",
      "@Analytics.dataCategory: #DIMENSION",
      "@EndUserText.label: 'Sales Order Item'",
      "@ObjectModel.representativeKey: 'SalesOrderItem'",
      "@VDM.viewType: #BASIC"
    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'ISALESORDERITEM'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Sales Order Item'\n@VDM.viewType: #BASIC\n\ndefine view I_SalesOrderItem\n  as select from vbap as Item\n  association [1..1] to I_SalesOrder as _SalesOrder\n    on $projection.SalesOrder = _SalesOrder.SalesOrder\n  association [0..1] to I_Product    as _Product\n    on $projection.Material = _Product.Product\n{\n  key Item.vbeln as SalesOrder,\n  key Item.posnr as SalesOrderItem,\n      Item.matnr as Material,\n      Item.arktx as SalesOrderItemText,\n      Item.kwmeng as OrderQuantity,\n      Item.vrkme as OrderQuantityUnit,\n      Item.netwr as NetAmount,\n      Item.waerk as TransactionCurrency,\n      Item.werks as Plant,\n      Item.lgort as StorageLocation,\n      Item.abgru as SalesDocumentRjcnReason,\n      _SalesOrder,\n      _Product\n}"
  },
  {
    "view_name": "I_BillingDocument",
    "ddl_source_name": "I_BILLINGDOCUMENT",
    "description": "Billing Document Header Data",
    "annotations": [
      "@AccessControl.authorizationCheck: #CHECK",
      "@Analytics.dataCategory: #DIMENSION",
      "@EndUserText.label: 'Billing Document Header'",
      "@ObjectModel.representativeKey: 'BillingDocument'",
      "@VDM.viewType: #BASIC"
    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'IBILLINGDOC'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Billing Document Header'\n@VDM.viewType: #BASIC\n\ndefine view I_BillingDocument\n  as select from vbrk as BillingDoc\n  association [0..*] to I_BillingDocumentItem as _Item\n    on $projection.BillingDocument = _Item.BillingDocument\n  association [0..1] to I_Customer            as _PayerCustomer\n    on $projection.PayerParty = _PayerCustomer.Customer\n{\n  key BillingDoc.vbeln as BillingDocument,\n      BillingDoc.fkart as BillingDocumentType,\n      BillingDoc.fkdat as BillingDocumentDate,\n      BillingDoc.fktyp as BillingDocumentCategory,\n      BillingDoc.kunrg as PayerParty,\n      BillingDoc.kunag as SoldToParty,\n      BillingDoc.netwr as TotalNetAmount,\n      BillingDoc.mwsbk as TotalTaxAmount,\n      BillingDoc.waerk as TransactionCurrency,\n      BillingDoc.bukrs as CompanyCode,\n      BillingDoc.vkorg as SalesOrganization,\n      BillingDoc.vtweg as DistributionChannel,\n      BillingDoc.spart as Division,\n      _Item,\n      _PayerCustomer\n}"
  },
  {
    "view_name": "I_BillingDocumentItem",
    "ddl_source_name": "I_BILLINGDOCUMENTITEM",
    "description": "Billing Document Item Data with Customer & Product",
    "annotations": [
