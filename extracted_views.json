      "@VDM.viewType: #BASIC"
    ],
    "ddl_code": "@AbapCatalog.sqlViewName: 'IBILLINGDOCITEM'\n@AccessControl.authorizationCheck: #CHECK\n@EndUserText.label: 'Billing Document Item'\n@VDM.viewType: #BASIC\n@Analytics.dataCategory: #FACT\n\ndefine view I_BillingDocumentItem\n  as select from vbrp as Item\n  association [1..1] to I_BillingDocument as _BillingDocument\n    on $projection.BillingDocument = _BillingDocument.BillingDocument\n  association [0..1] to I_Customer        as _PayerCustomer\n    on $projection.PayerParty = _PayerCustomer.Customer\n  association [0..1] to I_Product         as _Product\n    on $projection.Product = _Product.Product\n{\n  key Item.vbeln as BillingDocument,\n  key Item.posnr as BillingDocumentItem,\n      Item.aubel as SalesDocument,\n      Item.aupos as SalesDocumentItem,\n      Item.matnr as Product,\n      Item.arktx as BillingDocumentItemText,\n      Item.fkimg as BillingQuantity,\n      Item.vrkme as BillingQuantityUnit,\n      Item.netwr as NetAmount,\n      Item.mwsbp as TaxAmount,\n      Item.waerk as TransactionCurrency,\n      Item.kunrg as PayerParty,\n      Item.kunag as SoldToParty,\n      Item.werks as Plant,\n      Item.lgort as StorageLocation,\n      Item.prsdt as PricingDate,\n      _BillingDocument,\n      _PayerCustomer,\n      _Product\n}"
  },
